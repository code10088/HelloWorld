<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>KcpTestClient</AssemblyName>
    <RootNamespace>KcpTestClient</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\HelloWorld\Assets\Plugins\Kcp\*.cs"
             Exclude="..\..\HelloWorld\Assets\Plugins\Kcp\SimpleKcpClient.cs"
             Link="Kcp\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>