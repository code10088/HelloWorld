[Unit]
Description=HelloWorld test game server (TCP)
After=network.target

[Service]
Type=simple
User=aiserver
Group=aiserver
WorkingDirectory=/opt/aiserver/game
ExecStart=/opt/aiserver/game/GameServer
Environment=GAME_PORT=8088
# 2C2G 小机器不要用 Server GC，避免内存占用过高
Environment=DOTNET_gcServer=0
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target