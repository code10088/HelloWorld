<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>GameServerKcp</AssemblyName>
    <RootNamespace>GameServerKcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 直接复用工程内的 KCP 源码，避免复制一份后不同步 -->
    <Compile Include="..\..\HelloWorld\Assets\Plugins\Kcp\*.cs"
             Exclude="..\..\HelloWorld\Assets\Plugins\Kcp\SimpleKcpClient.cs"
             Link="Kcp\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>