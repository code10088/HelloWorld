[Unit]
Description=skynet game server (login + game, MySQL/Redis)
After=network.target mysql.service redis-server.service
Wants=mysql.service redis-server.service

[Service]
Type=simple
User=aiserver
Group=aiserver
WorkingDirectory=/opt/aiserver/skynet
ExecStart=/opt/aiserver/skynet/skynet mygame/config
Restart=always
RestartSec=3
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target