<module name="">
    <enum name="UIType">
        <var name="UITest" value="1"/>
        <var name="UICommonBox" value="2"/>
        <var name="UIHotUpdateRes" value="3"/>
        <var name="UIMain" value="4"/>
        <var name="UISetting" value="5"/>
        <var name="UICommonTips" value="6"/>
        <var name="UISceneLoading" value="7"/>
        <var name="UIGuide" value="8"/>
        <var name="UIMail" value="9"/>
        <var name="UIShowReward" value="10"/>
    </enum>
    <enum name="UIWindowType">
        <var name="Normal" value="0"/>
        <var name="Tips" value="1"/>
        <var name="Guide" value="2"/>
    </enum>
    <bean name="UIConfig">
        <var name="UIType" type="UIType"/>
        <var name="Name" type="string"/>
        <var name="PrefabPath" type="string"/>
        <var name="UIWindowType" type="UIWindowType"/>
    </bean>
    <table name="TbUIConfig" value="UIConfig" input="*@Json/UIConfig.json" mode="map" index="UIType"/>
</module>
